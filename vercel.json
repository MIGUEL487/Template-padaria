{
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/design-systems/:path*", "destination": "/", "permanent": false },
    { "source": "/design-system", "destination": "/", "permanent": false },
    { "source": "/design-system.html", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/release.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
